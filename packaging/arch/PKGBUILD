pkgname=malus
pkgver=0.1.0
pkgrel=1
pkgdesc='Roblox Player and Studio launcher for Linux through Rosemary'
arch=(x86_64)
url='https://github.com/dissering/Malus'
license=(GPL-3.0-only ISC OFL-1.1)
depends=(
  'gtk4>=1:4.18'
  'libadwaita>=1:1.7'
  'pango>=1:1.56'
  glib2
  glibc
  hicolor-icon-theme
  libgcc
  shared-mime-info
)
makedepends=(cargo clang desktop-file-utils glib2-devel lld)
# GCC and LLD use different LTO object formats for ring's C sources.
options=(!lto)
_revision=ed1ef33f9ebe66719a8e7cf7ca16cfefb1fbaa83
source=("${pkgname}-${pkgver}.tar.gz::https://codeload.github.com/dissering/Malus/tar.gz/${_revision}")
b2sums=('bfaab16e352af966316aa35c86aa1f929ffaf8bbfb68016f9f6ca18d1763d9b38afda374102fe805c8807533e6d530e37ac0b7c95a7bfe2c0f0956d4e4c8112d')

prepare() {
  cd "Malus-${_revision}"
  cargo fetch --locked --target x86_64-unknown-linux-gnu
}

build() {
  cd "Malus-${_revision}"
  cargo build --release --frozen
}

check() {
  cd "Malus-${_revision}"
  desktop-file-validate data/io.github.dissering.Tiltframe.desktop
  target/release/malus --version
}

package() {
  cd "Malus-${_revision}"
  local app_id=io.github.dissering.Tiltframe
  install -Dm755 target/release/malus "$pkgdir/usr/bin/malus"
  install -Dm644 "data/$app_id.desktop" "$pkgdir/usr/share/applications/$app_id.desktop"
  install -Dm644 "data/$app_id.xml" "$pkgdir/usr/share/mime/packages/$app_id.xml"
  for icon in data/icons/hicolor/*/apps/"$app_id".png; do
    install -Dm644 "$icon" "$pkgdir/usr/share/${icon#data/}"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/malus/LICENSE"
  install -Dm644 assets/lucide/LICENSE "$pkgdir/usr/share/licenses/malus/Lucide-LICENSE"
  install -Dm644 -t "$pkgdir/usr/share/licenses/malus" assets/fonts/*-OFL.txt
}
